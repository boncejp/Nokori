# --- クラウド Supabase（推奨・主路線）---
# Supabase ダッシュボード → Project Settings → API からコピーする。
# Project URL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon（公開）キー。ブラウザからのリクエストに使う。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role キー。サーバー専用バッチ・管理 API などのみ。ユーザーの通常 CRUD には使わない（RLS バイパス）。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ローカル Supabase（`supabase start` を使う場合のみ）---
# 上記をローカルに差し替える例（`supabase status` で表示される API URL / keys）:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
# SUPABASE_SERVICE_ROLE_KEY=<local service_role key>
