# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# npm + package-lock.json is canonical; ignore stray pnpm lockfiles (remove if you adopt pnpm).
pnpm-lock.yaml
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth/user.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa generated files
/public/sw.js
/public/workbox-*.js